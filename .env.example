# ==============================================================================
# Peblo TV Mini — Environment Configuration Example
# Copy this file to .env and replace placeholder secrets with secure values.
# ==============================================================================

# Application Settings
APP_NAME="Peblo TV Mini Content Catalogue"
ENVIRONMENT=production

# Database Configuration
# In Docker: postgresql+psycopg://peblo:peblo_secure_pass@db:5432/peblo_catalogue
# Local SQLite Dev fallback: sqlite:///data/catalogue/dev.db
DATABASE_URL=postgresql+psycopg://peblo:peblo_secure_pass@localhost:5432/peblo_catalogue

# PostgreSQL Credentials (for docker-compose)
POSTGRES_DB=peblo_catalogue
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo_secure_pass

# Authentication & Security
# Generate secure token using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-key-for-jwt-tokens-peblo-tv-mini
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Media Storage Provider
# Options: "local" (default disk storage) or "r2" (Cloudflare R2 / S3-compatible)
STORAGE_BACKEND=local
MEDIA_DIR=data/catalogue/uploads

# Cloudflare R2 / S3 Object Storage (Only needed if STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=peblo-catalogue
R2_PUBLIC_URL=https://assets.peblo.tv

# Default Admin & Editor Credentials created on seed:
# Admin:  username=admin,  password=admin123
# Editor: username=editor, password=editor123
